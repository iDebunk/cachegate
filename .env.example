# cachegate environment template
# Copy the values you need into your real .env file.
# NEVER commit .env to Git.

PORT=4000

# Required: protects the router from unauthorized use. The server
# refuses to start without this UNLESS ALLOW_INSECURE_LOCAL_DEV=true
# (below) is explicitly set - a missing key never silently means "no
# auth enforced."
# Generate with: openssl rand -hex 32
MODEL_ROUTER_INTERNAL_KEY=your-random-internal-key

# Optional: skip the MODEL_ROUTER_INTERNAL_KEY requirement above, for a
# throwaway LOCAL instance only. Never set this on anything reachable
# from outside your own machine.
# ALLOW_INSECURE_LOCAL_DEV=true

# Required (at least one provider key - any of the four). Which provider serves
# a request is decided by the model name in the API call's own "model" field
# (see README's "Usage" section), not configured here - there is no
# ANTHROPIC_MODEL/OPENAI_MODEL env var to set:
#   claude-*        -> Anthropic
#   gpt-*/o1*/o3*   -> OpenAI
#   deepseek-*      -> DeepSeek    (deepseek-flash, deepseek-v4-pro)
#   vendor/model    -> OpenRouter  (e.g. meta/llama-3-70b, deepseek/deepseek-chat)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional: DeepSeek. Two things worth knowing before you set this:
#  * pricing is TIME-AWARE here (DeepSeek bills peak and off-peak, off-peak
#    exactly half), so cost_usd - and cost-based routing - follows the current
#    billing window rather than one flat rate.
#  * DeepSeek reports its own disk-cache tiers (prompt_cache_hit_tokens /
#    prompt_cache_miss_tokens). Cached input is ~50x cheaper than a miss, and
#    those fields are mapped through, so a cached request shows its real cost
#    instead of being priced as if nothing was cached.
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com    # override for a proxy/gateway

# Optional: OpenRouter - one key, many vendors, addressed as vendor/model.
# Pricing is fetched from OpenRouter's own /models endpoint and cached, NOT
# hardcoded: their catalog is large and changes without a release of this
# project. When a model's price is unknown, cost_usd is null (never 0 - a zero
# would read as "free" to cost-based routing and win every comparison).
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_SITE_URL=https://your-app.example.com   # optional attribution headers:
# OPENROUTER_SITE_NAME=Your App                      # sent only if you set them
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # override for a proxy/gateway

# Also required for the semantic cache's embeddings, regardless of
# which provider actually serves chat requests - it's the only
# embedding backend implemented (see semanticCache.js / README).
# OPENAI_API_KEY=sk-proj-...

# Optional: which OpenAI embedding model the semantic cache uses.
# Only matters if OPENAI_API_KEY is set. Default is a good balance of
# cost and quality; change only if you know you want a different one.
# EMBEDDING_MODEL=text-embedding-3-small

# Optional: Redis for response caching (strongly recommended for cost savings)
# Local development:
# REDIS_URL=redis://localhost:6379
# Render Key Value:
# REDIS_URL=rediss://default:PASSWORD@HOST:PORT

# Optional: persistent metrics storage (see metrics.js's own comment).
# Unset (the default) keeps metrics as local JSONL files, which don't
# survive a restart/redeploy on most hosts - fine for a standalone
# deployment with no database of its own. Set this to a real Postgres
# connection string to persist metrics there instead.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
#
# MEMOCODE_ROUTER_DATABASE_URL does the exact same thing and takes
# priority over DATABASE_URL if both are set - use this instead when
# embedding cachegate inside an app that already has its own
# DATABASE_URL pointed at a different database (so the two never
# collide), or just to keep this router's own connection string
# explicitly distinct from whatever else reads DATABASE_URL in your stack.
# MEMOCODE_ROUTER_DATABASE_URL=postgres://user:pass@host:5432/dbname

# Optional: TLS verification for the Postgres connection above, if its
# certificate isn't signed by a publicly-trusted CA (most managed
# Postgres - RDS, Neon, Supabase - needs neither of these; it just works).
# Some providers issue a self-signed certificate per database instance
# instead (confirmed: Render's managed Postgres is one) - set PGSSL_CA to
# that CA's own PEM content, or PGSSL_CA_PATH to a file containing it.
# PGSSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# PGSSL_CA_PATH=/path/to/ca.pem
#
# PGSSL_INSECURE=true turns TLS verification off entirely (encrypted, but
# the server's identity is never checked) - an explicit escape hatch for a
# deployment that can't set either of the above right now, not a normal
# setting. Logs a warning on every use so it can't happen silently.
# PGSSL_INSECURE=true

# Optional: where JSONL metrics files live, if Postgres isn't
# configured. Despite the name, this now names a DIRECTORY (kept for
# backward compatibility with older configs that pointed it at a
# single file - see metrics.js's own comment). Defaults to ./data
# next to this file.
# METRICS_LOG_PATH=./data

# Optional: how long metrics history is kept before pruneOlderThan()'s
# scheduled daily job deletes it. Default 90 days deliberately matches
# /dashboard/data's own longest supported range - pruning any sooner
# would make its "Last 90 days" option quietly lie.
# METRICS_RETENTION_DAYS=90

# Optional: semantic cache tuning (all have sane defaults - see README's
# "Two kinds of cache hit" section before changing these).
# SEMANTIC_CACHE_ENABLED=false          # hard off-switch, even with a key configured
# SEMANTIC_CACHE_THRESHOLD=0.93         # cosine similarity floor for a match
# SEMANTIC_CACHE_MAX_CANDIDATES=200     # per-model list cap (brute-force scan size)
# SEMANTIC_CACHE_TTL_SECONDS=3600

# Optional: how many recent requests a provider needs before its error
# rate is treated as meaningful health data (router.js). Below this
# sample size, a provider is always considered healthy - a single
# unlucky request (1/1 or 1/2 errors) shouldn't bounce it out of
# rotation; it's noise, not a signal, until enough requests have run.
# ROUTER_HEALTH_MIN_SAMPLES=5

# Optional: hard timeout (ms) on each semantic-cache embedding call
# (embeddings.js). These sit on the hot request path (1-2 per cache
# miss, when SEMANTIC_CACHE_ENABLED is on) - a hung embedding provider
# would otherwise stall every chat request, including Anthropic-only
# ones with nothing to do with OpenAI. On timeout, the request degrades
# to "skip semantic caching" rather than hanging.
# EMBEDDING_TIMEOUT_MS=5000

# Optional: override the default "router:" virtual-model tiers
# (router.js's own DEFAULT_TIERS) with your own JSON, e.g. to add a
# model, swap a provider, or define a new tier name entirely. Must be
# valid JSON matching the shape:
# {"router:fast-cheap":[{"provider":"openai","model":"gpt-4o-mini"}]}
# Invalid JSON logs a warning and falls back to the built-in defaults
# rather than crashing.
# ROUTER_TIERS_JSON={"router:fast-cheap":[...]}

# Optional: routing strategy for "router:" virtual models (router.js).
# See README's "Where this leaves things" section for what each one
# actually does before changing this - there's no blended cost/latency
# score, only these three explicit options.
# ROUTER_STRATEGY=cost                        # default: cheapest healthy candidate
# ROUTER_STRATEGY=latency                     # fastest healthy candidate, cost only as a tiebreaker
# ROUTER_STRATEGY=latency-guarded-cost        # cheapest healthy candidate, excluding any that's too much slower than the fastest known one
# ROUTER_LATENCY_GUARD_MULTIPLIER=3           # only used by latency-guarded-cost

# Optional: rate limiting on /v1/* (server.js). Default 300 requests
# per 60 seconds - shared across EVERY caller of this router combined,
# not per end user if you're fronting it with your own per-user auth.
# See server.js's own comment above the rate limiter for the reasoning.
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW_MS=60000

# Optional: separate, more generous rate limit for the read-only
# aggregate endpoints (/stats, /dashboard/data) - lower stakes than
# /v1 (no provider spend on the line) but still real server work.
# Shares RATE_LIMIT_WINDOW_MS above.
# READ_RATE_LIMIT_MAX=120

# Optional: max JSON body size accepted on /v1/* (server.js). Default
# 2mb comfortably covers even a very long text conversation - this
# router doesn't support image/multimodal content, so there's no
# legitimate reason for a much larger payload. Raise only if you have
# a specific reason to expect longer request bodies.
# JSON_BODY_LIMIT=2mb

# Optional: guardrails (roadmap step 25). Both default OFF, run
# pre-dispatch (before either cache lookup, so cached content is
# already redacted/policy-checked), zero behavior change unless you opt in.

# PII redaction (pii.js): pattern-based (emails, phone numbers, SSNs,
# credit card numbers, common API-key/secret shapes), synchronous and
# local - no network call of its own. redact() never surfaces the
# actual matched value anywhere, even internally - only a
# {type, count} summary.
# GUARDRAILS_PII_REDACTION=true

# Prompt-injection detection (guardrails.js): heuristic patterns
# (instruction-override, system-prompt-leak, role-play jailbreak,
# "developer mode", DAN, "no restrictions" framing). GUARDRAILS_ENABLED
# turns detection on at all; GUARDRAILS_INJECTION_ACTION picks what
# happens on a hit - default `flag` (logged, request proceeds, since
# heuristics false-positive) or `block` (403, request rejected).
# GUARDRAILS_ENABLED=true
# GUARDRAILS_INJECTION_ACTION=flag   # flag (default) | block | log - flag and log currently behave identically (console.warn + pass through); block is the only one that changes the response (403)

# Optional: cascade routing (roadmap step 34). Default OFF - this is
# genuinely more speculative than health scoring (an LLM grading another
# LLM's confidence is inherently fuzzy), so it ships inert and only
# activates when explicitly opted in. Applies to "router:" virtual models
# only: dispatch to the top-ranked candidate, estimate its confidence, and
# escalate to the next candidate when below the threshold instead of
# accepting a cheap-but-unconfident answer.
# CASCADE_ENABLED=true

# Optional: the confidence floor (0-1) below which a successful response is
# escalated rather than accepted. Only matters when CASCADE_ENABLED=true.
# CASCADE_CONFIDENCE_THRESHOLD=0.5

# Optional: the small/cheap grader model used to estimate confidence for
# Anthropic candidates (Anthropic has no native logprobs; OpenAI confidence
# comes from logprobs automatically when cascade is on). Unset (default)
# means Anthropic candidates are never escalated - cascade fails open to
# "accept" when there's no confidence signal. Set it to a full model name
# the router has a key for (e.g. gpt-4o-mini or claude-haiku-4-5-20251001);
# the provider is inferred from the name.
# CASCADE_GRADER_MODEL=gpt-4o-mini

# Optional: OpenTelemetry export (roadmap step 36.2). Default OFF - ships
# fully inert; the SDK is never even loaded unless you opt in. Every request
# gets a root span (trace_id carried as a span attribute so it can be joined
# to the same request's metrics rows) plus child spans for cache lookup,
# coalescing wait, and each provider dispatch attempt.
# OTEL_ENABLED=true

# Required for the SDK to actually initialize when OTEL_ENABLED=true (the
# OTLP HTTP collector endpoint, e.g. http://localhost:4318/v1/traces). Unset
# = the SDK never initializes at all, not "initializes and exports nowhere."
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
