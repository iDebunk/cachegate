{
  "name": "cachegate",
  "version": "1.3.1",
  "description": "Self-hostable, OpenAI-compatible LLM proxy: routes to the cheapest healthy provider, caches responses exactly and semantically, tracks cost and latency per call.",
  "license": "MIT",
  "main": "server.js",
  "bin": {
    "cachegate": "./server.js"
  },
  "files": [
    "server.js",
    "cache.js",
    "cascade.js",
    "embeddings.js",
    "failover.js",
    "metrics.js",
    "redisClient.js",
    "router.js",
    "semanticCache.js",
    "streaming.js",
    "providers/",
    "public/",
    ".env.example"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "eval:semantic-cache": "node eval/semantic-cache-eval.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@huggingface/transformers": "^3.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "openai": "^4.28.4",
    "pg": "^8.23.0",
    "redis": "^4.7.0"
  }
}
